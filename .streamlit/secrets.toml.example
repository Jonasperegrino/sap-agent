# Streamlit Cloud secrets — copy to .streamlit/secrets.toml (gitignored) or set in Cloud dashboard
# Settings > Secrets. Env vars also work (SAP_AGENT_URL etc).

# Fiori app URL — defaults to live GitHub Pages if not set
# SAP_AGENT_URL = "https://jonasperegrino.github.io/sap-fiori/"

# Demo credentials (client-side gate, not real auth)
# SAP_AGENT_USER = "demo"
# SAP_AGENT_PASSWORD = "password123"

# Optional LLM for aggregate questions
# SAP_AGENT_LLM_API_KEY = "sk-..."
# SAP_AGENT_LLM_MODEL = "gpt-4o-mini"
# SAP_AGENT_LLM_BASE_URL = "https://api.openai.com/v1"
