    1: """Typed artifacts shared across the agent. No secrets may appear in these structures."""

    1: from __future__ import annotations

    1: from enum import StrEnum
    1: from typing import Any

    1: from pydantic import BaseModel, Field, SecretStr


    2: class AuthFailureKind(StrEnum):
    1:     """Taxonomy of authentication failures (issue #645)."""

    1:     BAD_CREDENTIALS = "bad_credentials"
    1:     TIMEOUT = "timeout"
    1:     ELEMENT_NOT_FOUND = "element_not_found"
    1:     REDIRECT_LOOP = "redirect_loop"
    1:     SSO_UNSUPPORTED = "sso_unsupported"
    1:     NETWORK_ERROR = "network_error"


    2: TRANSIENT_FAILURES = frozenset(
    1:     {
    1:         AuthFailureKind.TIMEOUT,
    1:         AuthFailureKind.ELEMENT_NOT_FOUND,
    1:         AuthFailureKind.NETWORK_ERROR,
           }
       )


    2: class AuthResult(BaseModel):
    1:     """Outcome of a login attempt. `detail` is always sanitized (no secrets)."""

    1:     ok: bool
    1:     kind: AuthFailureKind | None = None
    1:     landing_url: str | None = None
    1:     detail: str = ""
    1:     attempts: int = Field(ge=1)
           #: by route, e.g. `#/dashboard` — used as post-login verification target
    1:     verified_route: str | None = None

    2:     @property
    2:     def transient(self) -> bool:
               return self.kind in TRANSIENT_FAILURES

    1:     def kind_value(self) -> str:
               """Failure-kind string; 'unknown' when unset (success results)."""
               return self.kind.value if self.kind is not None else "unknown"

    1:     def sanitized(self) -> dict[str, Any]:
               """Serializable form guaranteed free of credentials."""
               return self.model_dump()


