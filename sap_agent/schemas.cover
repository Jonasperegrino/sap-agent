    1:     tool: str = ""
    1:     action: str = ""
    1:     status: str = ""


    2: class AgentResult(BaseModel):
    1:     """Emitted when the loop stops: success/failure + evidence (issue #684).

           `outcome` carries the last step's structured payload (e.g. AppSummary) so
           callers can consume the result without re-reading the browser. `trace` is a
           serializable copy of the session trace — secret-free by contract.
           """

    1:     goal: str
    1:     success: bool
    1:     steps_used: int
    1:     budget: int
    1:     reason: str = ""
    1:     failure_kind: FailureKind | None = None
    1:     outcome: Any = None
    1:     trace: list[TraceEntry] = Field(default_factory=list)
           #: planner mode only (#693): decided steps + rationale, in order
    1:     reasoning: list[PlannerDecision] = Field(default_factory=list)


