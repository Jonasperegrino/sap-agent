    1:     AGENT_LIMITATION = "agent_limitation"
    1:     UNSUPPORTED_AUTH_FLOW = "unsupported_auth_flow"


    2: class BugReport(BaseModel):
    1:     """Reproducible bug-report draft (issue #648). Secret-free by construction."""

    1:     title: str = ""
    1:     expected: str = ""
    1:     actual: str = ""
    1:     classification: FailureClass = FailureClass.AGENT_LIMITATION
    1:     reproduction_steps: list[str] = Field(default_factory=list)
    1:     environment: dict[str, str] = Field(default_factory=dict)
    1:     artifacts: list[str] = Field(default_factory=list)
    1:     trace_tail: list[str] = Field(default_factory=list)
           #: values scrubbed as [REDACTED] in rendered markdown (never empty by construction)
    1:     secret_values: list[str] = Field(default_factory=list)

    1:     def _scrub(self, text: str) -> str:
               for secret in self.secret_values:
                   if secret:
                       text = text.replace(secret, "[REDACTED]")
               return text

    1:     def to_markdown(self) -> str:
               title = self._scrub(self.title)
               expected = self._scrub(self.expected)
               actual = self._scrub(self.actual)
               lines = [
                   f"# {title}",
                   "",
                   f"**Classification**: `{self.classification.value}`",
                   "",
                   "## Expected",
                   expected,
                   "",
                   "## Actual",
                   actual,
                   "",
                   "## Reproduction steps",
               ]
               steps = [self._scrub(s) for s in self.reproduction_steps]
               lines += [f"{i}. {step}" for i, step in enumerate(steps, 1)]
               lines += [
                   "",
                   "## Environment",
                   "".join(f"- {k}: {self._scrub(v)}" for k, v in sorted(self.environment.items())),
                   "",
                   "## Attachments",
               ]
               lines += [f"- `{a}`" for a in self.artifacts] or ["- none"]
               lines += [
                   "",
                   "## Last agent actions (trace tail)",
               ]
               tail = [self._scrub(t) for t in self.trace_tail]
               lines += [f"- `{t}`" for t in tail] or ["- none"]
               return "\n".join(lines) + "\n"


    2: class StepStatus(StrEnum):
    1:     """Outcome of a single agent-loop step (issue #684)."""

    1:     SUCCESS = "success"
    1:     FAILURE = "failure"
    1:     SKIPPED = "skipped"


    2: class StepResult(BaseModel):
    1:     """Typed result of one loop step — controller verifies these deterministically."""

    1:     tool: str
    1:     action: str
    1:     status: StepStatus = StepStatus.SUCCESS
    1:     outcome: str = ""  # short machine-readable outcome string (nav-loop key)
    1:     detail: str = ""
    1:     url: str | None = None
           #: optional agent-failure classification (selector_failure, empty_state, ...)
    1:     kind: FailureKind | None = None
           #: true when the failure is transient and a state-reset retry may help
    1:     transient: bool = False
           #: optional structured payload (e.g. AppSummary) surfaced on AgentResult
    1:     payload: Any = None


